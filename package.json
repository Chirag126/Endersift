{
  "name": "endersift",
  "version": "0.1.0",
  "private": true,
  "description": "Budget-bounded threat-intelligence agent: ENSv2 provider discovery, 0G Private Computer inference, x402 payments settled on Hedera.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/holder-probe/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\" \"scripts/test/**/*.test.ts\"",
    "test:live": "node --test \"tests/live/**/*.live.test.ts\"",
    "env:example:check": "node scripts/check-env-example.ts",
    "env:check": "node scripts/check-env.ts",
    "secrets:scan": "node scripts/scan-secrets.ts --all",
    "test:negative": "node --test --test-reporter=spec apps/server/test/negative.mock.test.ts",
    "secrets:scan:staged": "node scripts/scan-secrets.ts --staged",
    "hedera:check-accounts": "node scripts/hedera/check-accounts.ts",
    "hedera:create-providers": "node scripts/hedera/create-provider-accounts.ts",
    "hcs:create-topic": "node scripts/hedera/hcs-create-topic.ts",
    "hcs:check": "node --disable-warning=ExperimentalWarning scripts/hedera/hcs-check.ts",
    "hedera:schedule-payment": "node scripts/hedera/schedule-payment.ts",
    "providers:start": "node apps/providers/src/server.ts",
    "x402:pay": "node scripts/hedera/x402-pay.ts",
    "x402:buy": "node --disable-warning=ExperimentalWarning scripts/hedera/x402-buy.ts",
    "providers:check": "node scripts/hedera/providers-check.ts",
    "firewall:check": "node scripts/hedera/firewall-check.ts",
    "payments:reconcile": "node --disable-warning=ExperimentalWarning scripts/hedera/payments-reconcile.ts",
    "payments:verify": "node --disable-warning=ExperimentalWarning scripts/hedera/payments-verify.ts",
    "net:check": "node scripts/net-check.ts",
    "agent:run": "node --disable-warning=ExperimentalWarning scripts/agent-run.ts",
    "api:start": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "api:check": "node scripts/api-check.ts",
    "schedule:evidence": "node --disable-warning=ExperimentalWarning scripts/schedule-evidence.ts",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/db/migrate.ts",
    "zg:models": "node scripts/zg/models.ts",
    "zg:infer": "node scripts/zg/infer.ts",
    "zg:structured": "node scripts/zg/structured.ts",
    "zg:balance": "node scripts/zg/balance.ts",
    "ledger:call": "node --disable-warning=ExperimentalWarning scripts/ledger/call.ts",
    "ledger:reconcile": "node --disable-warning=ExperimentalWarning scripts/ledger/reconcile.ts",
    "ledger:snapshot": "node --disable-warning=ExperimentalWarning scripts/ledger/snapshot.ts",
    "holder:probe": "pnpm --filter @agent-economy/holder-probe dev",
    "holder:lane": "pnpm --filter @agent-economy/holder-probe dev",
    "web:dev": "pnpm --filter @agent-economy/web dev",
    "web:build": "pnpm --filter @agent-economy/web build",
    "web:mock-api": "node --disable-warning=ExperimentalWarning scripts/web-mock-api.ts",
    "web:smoke": "node --disable-warning=ExperimentalWarning scripts/web-smoke.ts",
    "ens:register": "node scripts/ens/register-parent.ts",
    "ens:subname": "node scripts/ens/provision-subname.ts",
    "ens:resolve": "node scripts/ens/resolve.ts",
    "ens:provision": "node scripts/provision-ens.ts",
    "ens:permissions": "node scripts/ens/permissions.ts",
    "ens:discover": "node scripts/ens/discover.ts",
    "ens:discovery-proof": "node scripts/ens/discovery-proof.ts",
    "ens:setups": "node scripts/ens/setups.ts",
    "erc8004:register": "node scripts/ens/erc8004-register.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm web:build && pnpm test && pnpm env:example:check && pnpm secrets:scan"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm secrets:scan:staged && pnpm env:example:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
