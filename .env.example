# ─────────────────────────────────────────────────────────────────────────────
# Environment template. Copy to .env (never committed) and fill in your values:
#   Copy-Item .env.example .env        (Windows PowerShell)
# Then validate without printing any values:
#   pnpm env:check -- --groups core,hedera,x402
#
# Rules (enforced in CI by `pnpm env:example:check`):
#   - Every variable in packages/core/src/env/spec.ts appears here exactly once.
#   - Secret variables are always left blank in this file.
#   - Only VITE_* variables reach the browser, and none of them may be secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
SERVER_PORT=3001
DATABASE_PATH=./data/agent-economy.db
# Secret. Required to start paid runs on the public deployment (min 12 chars).
DEMO_ACCESS_CODE=
# Frontend origin allowed by CORS (with credentials). Empty = same origin only.
API_CORS_ORIGIN=
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (Render: 1).
API_TRUST_PROXY_HOPS=0
# Deployment (D-062). true when the host wipes the database on restart (Render free plan).
DATABASE_EPHEMERAL=
# Deployment: serve the built web app from the API on one origin (apps/web/dist). Empty = API only.
WEB_DIST_DIR=
# Deployment: seconds to keep retrying a provider catalog while a sleeping host wakes (Render free: 180).
PROVIDER_WAKE_SEC=
# Deployment: provider host origin the web app wakes from the browser (D-085). Empty = no wake.
PROVIDER_WAKE_ORIGIN=
# Deployment without a disk: a daily brief created at startup if missing (all three or none).
DAILY_BRIEF_WATCHLIST=
DAILY_BRIEF_RUN_AFTER=
DAILY_BRIEF_BUDGET_TINYBARS=

# ── hedera-network: which network, and where settlement is verified ────────
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ── hedera: agent payer account (testnet) ───────────────────────────────────
# Real 0.0.x account ID from portal.hedera.com (aliases are rejected by facilitators).
HEDERA_PAYER_ACCOUNT_ID=
# Secret. Hex or DER-hex private key of the payer account.
HEDERA_PAYER_PRIVATE_KEY=
# Optional. HCS audit topic printed by pnpm hcs:create-topic (0.0.N). Set: each settlement and a
# digest of each task are posted to it, paid by the payer. Unset: no audit messages.
HCS_TOPIC_ID=
HEDERA_PAYER_KEY_TYPE=ecdsa

# ── hedera-providers: payout accounts of the paid data providers ───────────
# label:0.0.N pairs, e.g. kev:0.0.12345 (set the real value in your local .env, never here).
# Use existing accounts, or create them with: pnpm hedera:create-providers -- --confirm
HEDERA_PROVIDER_ACCOUNTS=

# ── x402 ────────────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_FALLBACK_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera:testnet
# 0.0.0 = HBAR. Use an HTS token ID for token settlement.
X402_ASSET=0.0.0
# Client refuses any single payment above this many tinybars (0.01 HBAR), before signing.
X402_MAX_PAYMENT_TINYBARS=1000000
# Spending firewall budgets (tinybars): per run (settled + in flight + unknown) and per UTC day.
X402_RUN_BUDGET_TINYBARS=3000000
X402_DAILY_BUDGET_TINYBARS=10000000
# Spending firewall: payments per run, and the oldest ENS discovery snapshot a purchase may rely on (s).
X402_MAX_PAYMENTS_PER_RUN=10
X402_SNAPSHOT_MAX_AGE_SEC=600
# Optional. true = every payment refused and no task starts, whatever is saved in the UI. The
# lasting kill switch on a host that wipes its database on restart (D-062). Empty = not paused.
X402_PAYMENTS_PAUSED=
# Optional. Human approval mode (D-066): seconds the owner has to approve a payment. Default 600.
APPROVAL_TIMEOUT_SEC=
# Optional. The agent's own Hedera account that buyers of its brief pay (D-066). Not the payer,
# not a provider. Empty = the brief is not for sale.
AGENT_EARNINGS_ACCOUNT=

# ── providers: x402-protected services (no payer key needed) ───────────────
PROVIDERS_PORT=4021
# 100000 tinybars = 0.001 HBAR per paid request.
X402_DEMO_PRICE_TINYBARS=100000
# Optional. Public base URL of the provider service; must match the ENS agent.endpoint base
# (default http://127.0.0.1:<PROVIDERS_PORT>). Set the https URL after deployment.
PROVIDERS_PUBLIC_URL=
# Optional. USDC lane (plan row 37): price of /v1/<label>/ping-usdc in USDC atomic units
# (6 decimals; 10000 = 0.01 USDC). Empty = no USDC route.
X402_USDC_PING_ATOMIC=
# Optional. The agent earns (D-066): price in tinybars of /v1/agent/brief (its latest brief over
# x402, paid to AGENT_EARNINGS_ACCOUNT). Needs AGENT_PUBLIC_URL. Empty = not for sale.
BRIEF_SALE_PRICE_TINYBARS=
# Optional. The agent's public URL, where the brief for sale is read.
AGENT_PUBLIC_URL=
# Secret, optional. NVD API key (free at nvd.nist.gov); raises the cve provider's NVD limit 5 → 50 / 30 s.
NVD_API_KEY=

# ── ens: ENSv2 read path (server) ───────────────────────────────────────────
ENS_CHAIN=sepolia
# Secret. Sepolia JSON-RPC URL (Alchemy/Infura/etc.); usually embeds an API key.
ETH_RPC_URL=
# Parent .eth name registered on the ENSv2 Sepolia deployment.
ENS_PARENT_NAME=
# Optional. Block where the ENS log scan starts (the subregistry's deployment block, e.g.
# 11999808 for this project). Unset = search for it (many RPC calls; free plans rate-limit).
ENS_DISCOVERY_FROM_BLOCK=

# ── ens-admin: provisioning scripts only (never set on the deployed server) ─
# Secret. 0x-prefixed EVM key that owns ENS_PARENT_NAME.
ENS_ADMIN_PRIVATE_KEY=
# Base URL published as each agent endpoint (<base>/v1/<label>) by pnpm ens:provision.
# Local until the Render deployment; then set the https URL and re-provision.
ENS_AGENT_ENDPOINT_BASE=http://127.0.0.1:4021

# ── zg-network: which 0G Router (no secrets) ────────────────────────────────
# mainnet = pc.0g.ai (team/iAI credits) · testnet = pc.testnet.0g.ai (faucet 0G).
ZG_NETWORK=mainnet
# Testnet Router: https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1

# ── zg: 0G Private Computer inference ───────────────────────────────────────
# Secret. Router API key (sk-...) from Dashboard → API Keys on the matching site.
ZG_API_KEY=
# Secret, optional. Management key (mk-...) with scope account:read, for balance evidence.
ZG_MANAGEMENT_KEY=
# Model ID from the live catalog: pnpm zg:models
ZG_MODEL=
# max_tokens for every inference call.
ZG_OUTPUT_LIMIT=256
# Refuse calls whose worst-case catalog cost exceeds this (neuron; 1e18 = 1 0G).
ZG_MAX_CALL_COST_NEURON=1000000000000000
# Timeout for one inference call (ms); a timed-out call is never retried.
ZG_TIMEOUT_MS=60000
# Daily inference cap per UTC day (neuron); spent today + a call's worst case must fit. >= the per-call cap.
ZG_DAILY_CAP_NEURON=10000000000000000
# Minutes between Router balance snapshots (needs ZG_MANAGEMENT_KEY).
ZG_SNAPSHOT_INTERVAL_MIN=60
# Voice task (D-076): speech-to-text model as the 0G catalog names it (mainnet: whisper-large-v3; testnet has none), or off.
# One mainnet clip may bill up to ~0.28 0G (448 units x 0.00063 0G): to use it, set ZG_STT_MAX_NEURON=284000000000000000
# and ZG_DAILY_CAP_NEURON of at least that (D-080).
ZG_STT_MODEL=whisper-large-v3
# Worst case reserved per voice transcription (neuron); the real cost is recorded. <= the daily cap.
ZG_STT_MAX_NEURON=1000000000000000

# ── web: public, bundled into the browser ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
# 0G's Privy app ID (holder lane). Works only on localhost:3000/3001/5173.
VITE_PRIVY_APP_ID=
